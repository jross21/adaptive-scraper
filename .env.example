# Copy to .env and fill in. The .env file is gitignored; this template is committed.
# Loaded automatically at startup (see src/adaptive_scraper/config.py).

# Required for live codegen runs (the Anthropic SDK reads this variable).
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown). Uncomment to change.
# SCRAPER_CODEGEN_MODEL=claude-sonnet-4-6
# SCRAPER_MAX_REPAIR_ATTEMPTS=2
# SCRAPER_CACHE_DB=cache.db
# SCRAPER_RUNS_DIR=runs
# SCRAPER_TIMEOUT=20
# SCRAPER_TOKEN_BUDGET=10000
